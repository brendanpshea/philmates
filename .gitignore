# Build artifacts under dist/ are ignored by default...
dist/**
# ...except the SCORM packages, which are published downloads linked from the
# homepage (rebuild with: node tools/build-scorm.mjs --all).
!dist/
!dist/scorm/
!dist/scorm/**
temp/**

# Local secrets — never commit. See tools/cf-image.mjs.
.env.local
.env
# Dev-only: tools/a11y-audit.mjs asks for playwright + axe-core.
node_modules/
scratch/
